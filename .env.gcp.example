# Copy this file to .env.gcp on your GCP VM and fill in real values there.
# .env.gcp is intentionally ignored by .gitignore.

POSTGRES_USER=joblens
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=joblens

# Optional: set to your public URL after DNS is ready, for example:
# CORS_ORIGINS=https://joblens.example.com
CORS_ORIGINS=

# Optional: comma-separated API keys. If left blank, /api/v1/predict is public.
API_KEYS=

# Usually false on first deploy so output/jobs_master.csv seeds the database.
# Set true after the first successful seed if you want DB changes to persist.
SKIP_RESEED=false

# Optional Supabase auth. Leave blank to run the app without login gates.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
